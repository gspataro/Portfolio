{
    "website": {
        "name": "Giuseppe Spataro",
        "description": "Giuseppe Spataro, pianista e compositore siciliano",
        "author": "Giuseppe Spataro",
        "keywords": "pianista, musicista, sicilia",
        "email": "info@giuseppespataro.it",
        "theme": "gspataro",
        "friendly_urls": true
    },
    "media": {
        "images": {
            "sizes": {
                "thumbnail": {
                    "width": 400,
                    "quality": 90
                },
                "medium": {
                    "width": 600,
                    "quality": 90
                },
                "large": {
                    "width": 900,
                    "quality": 90
                },
                "full": {
                    "width": 1920,
                    "quality": 90
                },
                "original": {
                    "quality": 90
                }
            },
            "responsive": ["thumbnail", "medium", "large", "full"]
        }
    },
    "contents": {
        "articles": {
            "files": "articles/*.md",
            "reader": "markdown",
            "relationships": [
                {
                    "with": "articles_cats",
                    "field": "metadata.slug",
                    "operator": "containsAny",
                    "value": "metadata.categories"
                }
            ]
        },
        "articles_cats": {
            "files": "articles_categories/*.md",
            "reader": "markdown",
            "relationships": [
                {
                    "with": "articles",
                    "field": "metadata.categories",
                    "operator": "containsAny",
                    "value": "metadata.slug"
                }
            ]
        },
        "projects": {
            "files": "projects/*.md",
            "reader": "markdown",
            "relationships": [
                {
                    "with": "projects_cats",
                    "field": "metadata.slug",
                    "operator": "containsAny",
                    "value": "metadata.categories"
                }
            ]
        },
        "projects_cats": {
            "files": "projects_categories/*.md",
            "reader": "markdown",
            "relationships": [
                {
                    "with": "projects",
                    "field": "metadata.categories",
                    "operator": "containsAny",
                    "value": "metadata.slug"
                }
            ]
        },
        "webdev_projects": {
            "files": "webdev_projects/*.md",
            "reader": "markdown",
            "relationships": [
                {
                    "with": "webdev_projects_cats",
                    "field": "metadata.slug",
                    "operator": "containsAny",
                    "value": "metadata.categories"
                }
            ]
        },
        "webdev_projects_cats": {
            "files": "webdev_projects_categories/*.md",
            "reader": "markdown",
            "relationships": [
                {
                    "with": "webdev_projects",
                    "field": "metadata.categories",
                    "operator": "containsAny",
                    "value": "metadata.slug"
                }
            ]
        },
        "services": {
            "files": "services.json",
            "reader": "json"
        },
        "experiences": {
            "files": "experiences.json",
            "reader": "json"
        }
    },
    "schemas": {
        "index": {
            "contents": [
                {
                    "group": "articles",
                    "limit": 5,
                    "orderBy": "frontmatter.published",
                    "order": "desc"
                },
                "services"
            ],
            "template": "index",
            "slug": "/index",
            "generate": "once"
        },
        "404": {
            "template": "404",
            "slug": "/404",
            "generate": "once"
        },
        "darkside": {
            "template": "darkside",
            "slug": "/darkside",
            "generate": "once"
        },
        "webdev@index": {
            "contents": [
                {
                    "group": "webdev_projects",
                    "orderBy": "frontmatter.published",
                    "order": "desc"
                }
            ],
            "template": "webdev",
            "slug": "/webdev/index",
            "generate": "once"
        },
        "about": {
            "contents": [
                "services",
                "experiences"
            ],
            "template": "about",
            "slug": "/chi-sono",
            "generate": "once"
        },
        "article": {
            "contents": [
                "articles"
            ],
            "template": "article",
            "slug": "/articolo",
            "generate": "loop",
            "source": "articles"
        },
        "webdev_project": {
            "contents": [
                "webdev_projects"
            ],
            "template": "webdev_project",
            "slug": "/webdev",
            "generate": "loop",
            "source": "webdev_projects"
        },
        "blog": {
            "contents": [
                {
                    "group": "articles",
                    "orderBy": "frontmatter.published",
                    "order": "desc"
                }
            ],
            "template": "blog",
            "slug": "/blog",
            "generate": "archive",
            "source": "articles",
            "options": {
                "per_page": 12
            }
        },
        "project": {
            "contents": [
                "projects"
            ],
            "template": "project",
            "slug": "/progetto",
            "generate": "loop",
            "source": "projects"
        },
        "projects": {
            "contents": [
                {
                    "group": "projects",
                    "orderBy": "frontmatter.published",
                    "order": "desc"
                }
            ],
            "template": "projects",
            "slug": "/progetti",
            "generate": "archive",
            "source": "projects",
            "options": {
                "per_page": 12
            }
        }
    }
}
