{%from './components/icon.html' import icon%}
{%extends "./layout/default.twig"%}
{%block main%}
        <section class="bg-thunder-darker rounded-3xl flex flex-col-reverse text-ivory-lightest/80 mb-3xl tablet-h:flex-row tablet-h:justify-between tablet-h:items-stretch">
            <div class="p-xs prose tablet-h:max-w-3/5 tablet-h:p-lg">
                <h1 class="text-ivory-lightest">
                    Mi presento
                </h1>
                <p>
                    Mi chiamo Giuseppe Spataro.
                </p>
                <p>
                    Mi occupo di musica, sviluppo web e didattica. Sono ambiti diversi, ma quello che mi interessa è il modo in cui si costruiscono le cose: progettare, risolvere problemi e lavorare con attenzione ai dettagli.
                </p>
                <p>
                    Accanto alla parte operativa, porto avanti una componente di riflessione: cerco di capire cosa funziona, perché funziona e come può essere migliorato nel tempo.
                </p>
                <p>
                    Lavoro su linguaggi diversi, ma con un approccio comune, orientato alla chiarezza, alla qualità e alla costruzione di qualcosa che abbia senso nel tempo.
                </p>
            </div>
            <figure aria-label="Foto di Giuseppe Spataro" class="h-inherit min-h-70 mx-3xs mt-3xs tablet-h:max-w-2/5 tablet-h:m-0">
                {{image('/about-photo.jpg', 'medium', {
                    'class': 'aspect-square object-top object-cover w-full h-full rounded-xl tablet-h:rounded-3xl',
                    'alt': 'Uomo dal sorriso accennato con capelli e barba scuri che indossa una camicia azzurra e una cravatta blu su uno sfondo bianco'
                })}}
            </figure>
        </section>
        {%include './components/slider-services.html' with {
            'title': 'Cosa faccio',
            'class': 'mb-3xl'
        }%}
        <div class="prose mb-3xl tablet-h:w-2/3">
            <h2>
                Esperienze
            </h2>
            <p>
                Nel corso della mia formazione ho partecipato a numerose masterclass con pianisti di rilievo internazionale, approfondendo repertori e approcci interpretativi. Ho preso parte a concorsi nazionali e ho maturato un'ampia esperienza concertistica, sia come solista che come pianista accompagnatore.
            </p>
            <p>
                Negli ultimi anni ho affiancato all'attività performativa l'insegnamento strumentale e la composizione, dedicandomi in particolare alla creazione di contenuti musicali per il branding aziendale e la comunicazione sonora.
            </p>
        </div>
        <div class="bg-brass-lightest flex flex-col-reverse gap-3xs p-sm rounded-3xl tablet-v:p-lg tablet-v:justify-between tablet-v:flex-row tablet-v:items-center">
            <div class="prose tablet-v:w-2/3 tablet-h:w-1/2">
                <h2>Side project</h2>
                <p class="text-sm">
                    Sono appassianato di tecnologia e da anni mi occupo di sviluppo web. Ho realizzato numerosi progetti e mi piace cimentarmi
                    nell'apprendimento di nuovi concetti legati alla programmazione.
                </p>
                <a href="{{url('webdev@index')}}" class="cta text-inherit">
                    Scopri di più
                </a>
            </div>
            <div class="text-thunder-darkest/10">
                {{icon('dev', 120, attributes: {
                    'class': 'w-14 h-14 tablet-v:w-auto tablet-v:h-auto',
                    'aria-hidden': 'true'
                })}}
            </div>
        </div>
{%endblock%}
