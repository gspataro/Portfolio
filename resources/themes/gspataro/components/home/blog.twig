{%embed './components/home/section.twig' with {
    'label': 'Blog',
    'prev_text': 'Chi sono',
    'style': 'pianoforte',
    'id': 'blog'
}%}
    {%block content%}
        <div class="mb-2xl tablet-v:w-2/3 tablet-h:w-1/2">
            <h3 class="mb-3xs">
                Cogito ergo sum
            </h3>
            <p class="text-sm mb-xs">
                Qui condivido riflessioni, spunti e approfondimenti sui tre ambiti che animano il mio lavoro: musica, didattica e tecnologia. Idee pratiche, consigli e prospettive per chi ama esplorare e imparare.
            </p>
            <a href="{{url('blog.page-1')}}" class="cta">
                VAI AL BLOG
            </a>
        </div>
        {%include './components/slider-blog.twig' with {
            'title': 'Ultimi articoli',
            'title_tag': 'h3'
        }%}
    {%endblock%}
{%endembed%}
