{%embed './components/home/section.twig' with {
    'label': 'Chi sono',
    'prev_text': 'Benvenuto',
    'next_text': 'Blog',
    'style': 'fortepiano',
    'id': 'chi-sono'
}%}
    {%block content%}
        <div class="laptop-sm:flex-1 laptop-sm:h-full laptop-sm:flex laptop-sm:items-center">
            <div class="flex flex-col-reverse gap-sm text-ivory-lightest/80 laptop-sm:flex-row laptop-sm:justify-between laptop-sm:items-stretch">
                <div class="prose">
                    <h3 class="mb-3xs text-ivory-lightest">
                        Mi occupo di <span class="text-brass">musica</span>,<br>
                        <span class="text-brass">didattica</span> e <span class="text-brass">sviluppo web</span>
                    </h3>
                    <p class="text-h5 text-ivory-lightest/80 mb-sm">
                        Tre ambiti diversi, che condividono lo stesso approccio
                    </p>
                    <ul class="flex flex-col p-0 gap-xs">
                        <li class="flex gap-3xs">
                            <div class="text-h4 leading-[1.2]">1.</div>
                            <div>
                                <h4 class="mb-4xs text-ivory-lightest">Progettare</h4>
                                <p>Definire la struttura e l’idea di base</p>
                            </div>
                        </li>
                        <li class="flex gap-3xs">
                            <div class="text-h4 leading-[1.2]">2.</div>
                            <div>
                                <h4 class="mb-4xs text-ivory-lightest">Lavorare sui dettagli</h4>
                                <p>Curare ogni aspetto, dalle note agli elementi digitali</p>
                            </div>
                        </li>
                        <li class="flex gap-3xs">
                            <div class="text-h4 leading-[1.2]">3.</div>
                            <div>
                                <h4 class="mb-4xs text-ivory-lightest">Migliorare nel tempo</h4>
                                <p>Analizzare, testare e affinare continuamente metodi e strategie</p>
                            </div>
                        </li>
                    </ul>
                </div>
                <figure aria-label="Foto di Giuseppe Spataro" class="h-inherit min-h-70 tablet-v:max-h-120 tablet-h:max-h-70 laptop-sm:max-h-full laptop-sm:max-w-2/5">
                    {{image('/home-photo.jpg', 'medium', {
                        'class': 'aspect-square object-center object-cover w-full h-full max-h-[inherit] rounded-xl tablet-h:rounded-3xl',
                        'alt': 'Uomo dal sorriso accennato con capelli e barba scuri che indossa una camicia azzurra e una cravatta blu su uno sfondo bianco'
                    })}}
                </figure>
            </div>
        </div>
    {%endblock%}
{%endembed%}
