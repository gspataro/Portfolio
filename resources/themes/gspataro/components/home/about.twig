{%embed './components/home/section.twig' with {
    'label': 'Chi sono',
    'prev_text': 'Benvenuto',
    'next_text': 'Blog',
    'style': 'fortepiano',
    'id': 'chi-sono'
}%}
    {%block content%}
        <div class="laptop-lg:mx-auto laptop-lg:max-w-2/3">
            <div class="mb-lg bg-thunder-darker p-md rounded-3xl">
                <h3 class="mb-3xs">
                    Mi occupo di <span class="text-brass">musica</span>,<br>
                    <span class="text-brass">didattica</span> e <span class="text-brass">sviluppo web</span>
                </h3>
                <p class="text-h5 text-ivory-lightest/80">
                    Tre ambiti diversi, che condividono lo stesso approccio
                </p>
            </div>
            <ul class="flex flex-col">
                <li class="flex gap-3xs py-sm border-t border-b border-thunder-dark">
                    <div class="text-h4 leading-[1.2]">1.</div>
                    <div>
                        <h4 class="mb-4xs">Progettare</h4>
                        <p class="text-ivory-lightest/80">Definire la struttura e l’idea di base</p>
                    </div>
                </li>
                <li class="flex gap-3xs py-sm border-b border-thunder-dark">
                    <div class="hidden tablet-v:block tablet-v:flex-1"></div>
                    <div class="text-h4 leading-[1.2]">2.</div>
                    <div>
                        <h4 class="mb-4xs">Lavorare sui dettagli</h4>
                        <p class="text-ivory-lightest/80">Curare ogni aspetto, dalle note agli elementi digitali</p>
                    </div>
                </li>
                <li class="flex gap-3xs py-sm border-b border-thunder-dark">
                    <div class="text-h4 leading-[1.2]">3.</div>
                    <div>
                        <h4 class="mb-4xs">Migliorare nel tempo</h4>
                        <p class="text-ivory-lightest/80">Analizzare, testare e affinare continuamente metodi e strategie</p>
                    </div>
                </li>
            </ul>
            <div class="mt-xl text-h5 text-ivory-lighest/80 text-center">
                Leggi di più su <a href="{{url('about')}}" class="cta text-ivory-lightest">chi sono</a>
            </div>
        </div>
    {%endblock%}
{%endembed%}
