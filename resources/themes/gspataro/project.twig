{%set page = {
    'title': post.metadata.name,
    'layout': {
        'contain': true,
        'breadcrumb': {
            'index': 'Home',
            'projects.page-1': 'Progetti',
            '': post.metadata.name
        }
    },
    'meta': {
        'description': post.metadata.description,
        'keywords': post.metadata.keywords
    }
}%}
{%extends "./layout/default.twig"%}
{%block main%}
    {%set main_category = related('projects_cats')|first%}
    {%set category%}
        <span class="inline px-3xs border border-thunder-darkest rounded-full font-normal lowercase">
            {{main_category.metadata.name}}
        </span>
    {%endset%}
    <article class="max-w-[800px] mx-auto">
        <header class="mb-lg tablet-v:w-2/3 tablet-h:w-1/2">
            <div class="flex items-center mb-md">
                <h1 class="flex-1">{{post.metadata.name}}</h1>
            </div>
            {%include './components/post/meta.html' with {'meta': {
                "Cliente": post.metadata.client,
                "Servizi": post.metadata.services,
                "Categoria": category
            }} only%}
        </header>
        <div class="prose">
            {{post.body|orchestra_content}}
        </div>
    </article>
{%endblock%}
