{%set page = {
    'title': post.metadata.name,
    'layout': {
        'contain': true,
        'breadcrumb': {
            'index': 'Home',
            'projects.page-1': 'Progetti',
            '': post.metadata.name
        }
    },
    'meta': {
        'description': post.metadata.description,
        'keywords': post.metadata.keywords
    }
}%}
{%extends "./layout/default.twig"%}
{%block main%}
    <article class="max-w-200 mx-auto">
        <header class="mb-lg tablet-v:w-2/3 tablet-h:w-1/2">
            <div class="flex items-center mb-md">
                <h1 class="flex-1">{{post.metadata.name}}</h1>
            </div>
            {%include './components/project/meta.twig' with {'meta': {
                "Cliente": post.metadata.client,
                "Servizi": post.metadata.services,
                "Categorie": related('projects_cats') ? include('./components/article/categories.twig', {categories: related('projects_cats')}) : '',
                "Links": include('./components/project/links.twig', {project: post})
            }} only%}
        </header>
        <div class="prose">
            {{post.body|orchestra_content}}
        </div>
    </article>
{%endblock%}
